  "workflow": {
    "source_scope": "项目 primarily documents Web there login; connecting it to each mobile bootstrap is supported by shared site session and JS /login target, not a newly captured seamless end-to-end login trace",
    "entry": {
      "operationId": "openLoginPage",
      "parameter": "from=web",
      "documented_alternative": "handleThereOAuthCallback without code"
    },
    "authentication_alternatives": {
      "password": {
        "operations": [
          "openSsoLoginPage",
          "ssoPasswordLogin",
          "ssoSendTwoStepCode",
          "ssoVerifyTwoStepCode"
        ],
        "two_step_condition": "twoStepRequired=true",
        "result_cookie": "SHU_OAUTH2"
      },
      "wecom": {
        "operations": [
          "wecomOpenLoginQr",
          "wecomPollLoginQr",
          "ssoRedeemWecomCode"
        ],
        "browser_transport_alternative": "wecomBrowserLoginQrPoll",
        "result_cookie": "SHU_OAUTH2"
      }
    },
    "authorization": {
      "operationId": "ssoAuthorizeThere",
      "client_profile": {
        "client_id": "eDrd-M0i0WoSWRxk7ShDC1n-fbS7jRvi",
        "redirect_uri": "https://there.shu.edu.cn/login-oauth2",
        "scope": "1"
      }
    },
    "site_session": {
      "operationId": "handleThereOAuthCallback",
      "cookie_names": [
        "SPHYS_SESSION",
        "authenticityToken"
      ],
      "landing_operation": "openThereWebLanding",
      "spa_route": "/web/home"
    },
    "mobile_bridge": {
      "observed_operations": [
        "openLIBPage",
        "openSTATIONPage",
        "openSEATPage",
        "openCSPage"
      ],
      "bootstrap_header_relation": "HTML.sessionId equals x-hys-session",
